# Enforce LF normalization on Windows
*.yaml eol=lf
*.lua eol=lf
*.cs eol=lf
*.csproj eol=lf
*.sln eol=lf
* text=lf

# Custom for Visual Studio
*.cs     diff=csharp

# Shell scripts and the shell-sourced mod.config must keep LF on every checkout
*.sh eol=lf
mod.config eol=lf
user.config eol=lf

# missions/ came from OpenRA-AI (1 Nov 2026), which exported it under core.autocrlf. Keep that, so the /play
# release's missions snapshot (RTSAI-WebGame tools/prepare-inputs.py --committed) stays byte-identical.
missions/** !eol
