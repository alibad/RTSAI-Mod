<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<EngineRootPath>../engine</EngineRootPath>
	</PropertyGroup>

	<Import Project="$(EngineRootPath)/Directory.Build.props" />

	<ItemGroup>
		<ProjectReference Include="$(EngineRootPath)/OpenRA.Game/OpenRA.Game.csproj">
			<Private>False</Private>
		</ProjectReference>

		<ProjectReference Include="$(EngineRootPath)/OpenRA.Mods.Common/OpenRA.Mods.Common.csproj">
			<Private>False</Private>
		</ProjectReference>

		<!-- Art preview: WithAnimatedVoxelModel draws through Mods.Cnc's RenderVoxels. -->
		<ProjectReference Include="$(EngineRootPath)/OpenRA.Mods.Cnc/OpenRA.Mods.Cnc.csproj">
			<Private>False</Private>
		</ProjectReference>
	</ItemGroup>

	<!--
		AI companion bridge (spike): Kestrel-hosted gRPC server owned by the mod assembly.
		Same package versions as the fork engine so a single copy of each dependency lands in bin/.
	-->
	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
		<PackageReference Include="Google.Protobuf" Version="3.29.3" />
		<PackageReference Include="Grpc.Tools" Version="2.69.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="Companion/Protos/rl_bridge.proto" GrpcServices="Server" />
	</ItemGroup>

	<!--
		Build stamp for the main menu's version line (RTSAIVersionLabelLogic): the git commit this assembly was compiled
		from, "-dirty" with uncommitted changes. Packaged builds show the manifest version instead (make version).
		Without git the stamp is empty and the menu says so.
	-->
	<Target Name="RTSAIBuildStamp" BeforeTargets="GetAssemblyAttributes">
		<Exec Command="git describe --always --dirty --abbrev=7" ConsoleToMSBuild="true" IgnoreExitCode="true"
			StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
			<Output TaskParameter="ConsoleOutput" PropertyName="RTSAIBuildRaw" />
			<Output TaskParameter="ExitCode" PropertyName="RTSAIBuildExit" />
		</Exec>
		<PropertyGroup>
			<RTSAIBuild Condition="'$(RTSAIBuildExit)' == '0'">$(RTSAIBuildRaw)</RTSAIBuild>
		</PropertyGroup>
		<ItemGroup>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>RTSAIBuild</_Parameter1>
				<_Parameter2>$(RTSAIBuild)</_Parameter2>
			</AssemblyAttribute>
		</ItemGroup>
	</Target>

	<ItemGroup>
		<None Include="$(EngineRootPath)/AUTHORS">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
